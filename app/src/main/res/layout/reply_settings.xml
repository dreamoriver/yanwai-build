<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <com.google.android.material.card.MaterialCardView style="@style/Yanwai.SettingsCard">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/Yanwai.Section" android:layout_width="0dp" android:layout_weight="1" android:layout_marginTop="0dp" android:text="回复连接" />
                <com.google.android.material.button.MaterialButton android:id="@+id/toggleReplyForm" style="@style/Yanwai.Button.Text" android:layout_width="wrap_content" android:text="修改" />
            </LinearLayout>
            <TextView android:id="@+id/replyFormSummary" style="@style/Yanwai.Caption" android:accessibilityLiveRegion="polite" />
            <LinearLayout android:id="@+id/replyFormGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/replyStatus" style="@style/Yanwai.Badge" android:layout_marginTop="8dp" android:visibility="gone" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/providerLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="渠道">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/provider" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="none" android:importantForAutofill="no" android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/providerHint" style="@style/Yanwai.Caption" android:layout_marginTop="6dp" android:maxLines="2" android:ellipsize="end" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/keyLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="API Key" app:endIconMode="password_toggle" app:helperText="仅保存在本机。">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/apiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textPassword" android:singleLine="true" android:importantForAutofill="no" android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/endpointLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="API 地址" android:visibility="gone" app:helperText="Base URL 或完整的 /chat/completions 地址。">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/endpoint" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textUri" android:maxLines="3" android:importantForAutofill="no" android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/modelLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="模型 ID">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/model" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textVisiblePassword" android:completionThreshold="0" android:singleLine="true" android:importantForAutofill="no" android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/referenceModels" style="@style/Yanwai.Button.Text" android:layout_width="wrap_content" android:layout_gravity="start" android:visibility="gone" android:text="用官方文档模型" />
                <com.google.android.material.button.MaterialButton android:id="@+id/fetchModels" style="@style/Yanwai.Button.Text" android:layout_width="wrap_content" android:layout_gravity="start" android:text="获取模型列表" />
                <TextView android:id="@+id/modelsStatus" style="@style/Yanwai.Caption" android:accessibilityLiveRegion="polite" />
                <com.google.android.material.button.MaterialButton android:id="@+id/providerConsole" style="@style/Yanwai.Button.Text" android:layout_width="wrap_content" android:layout_gravity="start" android:text="去官方平台获取 Key ↗" />
                <com.google.android.material.button.MaterialButton android:id="@+id/testReply" style="@style/Yanwai.Button" android:layout_marginTop="12dp" android:text="保存并检测回复连接" />
                <TextView style="@style/Yanwai.Caption" android:text="检测只用示例聊天，不读取微信消息，可能产生少量费用。" />
                <com.google.android.material.button.MaterialButton android:id="@+id/saveReply" style="@style/Yanwai.Button.Text" android:text="仅保存配置" />
                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progressReply" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone" android:contentDescription="正在检测回复模型" />
                <TextView android:id="@+id/replyResult" style="@style/Yanwai.Body" android:layout_marginTop="12dp" android:padding="16dp" android:background="@drawable/status_pill" android:visibility="gone" android:accessibilityLiveRegion="polite" android:textIsSelectable="true" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
