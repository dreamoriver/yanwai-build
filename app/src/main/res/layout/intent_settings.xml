<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <com.google.android.material.card.MaterialCardView style="@style/Yanwai.SettingsCard">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView style="@style/Yanwai.Section" android:layout_marginTop="0dp" android:text="分析连接" />
            <TextView android:id="@+id/connectionSummary" style="@style/Yanwai.Body" android:text="分析连接还没有配置。" />
            <TextView style="@style/Yanwai.Caption" android:layout_marginTop="8dp" android:text="情绪判断和意图解读共用这一条连接。在首页点「分析连接」可以修改。" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView style="@style/Yanwai.SettingsCard">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView style="@style/Yanwai.Section" android:layout_marginTop="0dp" android:text="分析卡片显示" />
            <TextView style="@style/Yanwai.Caption" android:text="决定分析卡片上能看到哪几行解读。切换立即保存，不会重新分析。" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/showIntent" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="显示意图解析" android:saveEnabled="false" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/showConcern" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="显示可能在意" android:saveEnabled="false" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/showTone" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="显示情绪倾向" android:saveEnabled="false" />
            <TextView android:id="@+id/cardDisplayStatus" style="@style/Yanwai.Caption" android:accessibilityLiveRegion="polite" />
            <TextView style="@style/Yanwai.Caption" android:layout_marginTop="4dp" android:text="情绪指标和失败提示始终保留。" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView style="@style/Yanwai.SettingsCard">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView style="@style/Yanwai.Section" android:layout_marginTop="0dp" android:text="自动分析" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchChatDefault" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="自动分析（所有聊天）" android:saveEnabled="false" />
            <TextView style="@style/Yanwai.Caption" android:text="开启后所有聊天都会自动分析，每个聊天都会请求模型，可能产生费用；关闭时仍可长按消息「翻译意图」单条解读。" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
